} */
html.dark .fancy-title2 {
	/* font-size: 2rem; */
	font-weight: 800;
	background: linear-gradient(
		-45deg,
		#ffadff,
		#ffd6ff,
		#cafffb,
		#d2f1ff,
		#ffadff
	);
	background-size: 300% 300%;
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	animation: shimmer 4s ease-in-out infinite;
	position: relative;
}
@keyframes shimmer {
	0% { background-position: 0% 50%; }
	50% { background-position: 100% 50%; }
	100% { background-position: 0% 50%; }
}

@keyframes shimmer3 {
  0% { 
    background-position: 0% 50%;
    background-size: 100%;
    outline: 2px solid rgb(var(--color-primary-500));
    /* outline-offset: 0px; */
  }
  40% {
    background-position: 100% 50%;
    background-size: 140%;
    outline: 2px solid rgb(var(--color-secondary-500));
    /* outline-offset: 3px; */
  }
  70% {
    background-position: 0% 50%;
    background-size: 120%;
    outline: 2px solid rgb(var(--color-tertiary-500));
    /* outline-offset: 1px; */
  }
  100% { 
    background-position: 0% 50%;
    background-size: 100%;
    outline: 2px solid rgb(var(--color-primary-500));
    /* outline-offset: 0px; */
  }
}
.discord {
  --color-primary-50: 234 237 250;
  --color-primary-100: 227 232 248;
  --color-primary-200: 220 226 246;
  --color-primary-300: 199 208 241;
  --color-primary-400: 157 173 230;
  --color-primary-500: 115 138 219;
  --color-primary-600: 104 124 197;
  --color-primary-700: 86 104 164;
  --color-primary-800: 69 83 131;
  --color-primary-900: 56 68 107;
}

html body {
  --token-1: var(--color-surface-100);
  --token-2: var(--color-warning-50);
  --token-3: 1.0;
}
html .pf-bg {
  @apply bg-surface-50;
}
html.dark .pf-bg {
  @apply bg-surface-800;
}
html:not(.dark) body .variant-ghost,
html:not(.dark) body .variant-ghost-surface {
  --tw-ring-color: rgb(var(--color-surface-300) / var(--tw-ring-opacity));
  background-color: rgb(var(--color-surface-200) / 0.2);
}
html.dark body {
  --token-1: var(--color-surface-800);
  --token-2: var(--color-warning-500);
  --token-3: 0.2;
}
.featured {
  border: 1px solid rgba(var(--color-warning-500) / .7);
  background-image: linear-gradient(to bottom, rgb(var(--token-1)), rgba(var(--token-2) / var(--token-3)));
}
.legendary {
  border: 1px solid rgba(var(--color-primary-500) / .74);
  background-image: linear-gradient(to bottom, rgb(var(--token-1)), rgba(var(--color-primary-500) / .26));
  /* outline: 1px solid rgba(var(--color-primary-500) / .5); */
  /* outline: 1px solid rgba(var(--color-secondary-500) / .75); */
  /* background-image: linear-gradient(to bottom, rgb(var(--color-surface-800)), rgba(var(--color-primary-500) / .2)); */
  /* background-image: linear-gradient(to bottom right, rgb(var(--color-surface-800)), rgba(var(--color-secondary-500) / .09), rgba(var(--color-tertiary-500) / .16)); */
}
.mythic {
  outline: 1px solid rgba(var(--color-success-500) / .81);
  /* background-image: radial-gradient(circle at top left, rgb(var(--color-surface-800)), rgba(var(--color-primary-500) / .1), rgba(var(--color-secondary-500) / .2), rgba(var(--color-tertiary-500) / .3)); */
  /* background-image: linear-gradient(
    to top left,
    rgba(var(--color-primary-500) / .21) 1%,
    rgba(var(--color-primary-500) / .24) 10%,
    rgba(var(--color-primary-500) / .21) 20%,
    rgba(var(--color-secondary-500) / 0.16),
    rgba(var(--color-tertiary-500) / 0.09),
    transparent
  ); */
  /* background-image: linear-gradient(45deg, rgba(var(--color-secondary-500) / .1), rgba(var(--color-tertiary-500) / .3)); */
  background-image: linear-gradient(to bottom, rgb(var(--token-1)), rgba(var(--color-success-500) / .26));
  
  /* animation: shimmer3 4s ease-in-out infinite; */
  /* position: relative; */
  /* overflow: hidden; */
}
.plasmatic {
  outline: 1px solid rgba(var(--color-senary-300) / .91);
  background-image: linear-gradient(to bottom, rgb(var(--token-1)), rgba(var(--color-senary-500) / .36));
}
.celestial {
  outline: 1px solid rgba(var(--color-nonary-300) / .91);
  background-image: linear-gradient(to bottom, rgb(var(--token-1)), rgba(var(--color-nonary-500) / .36));
}

.loader {
    width: 32px;
    aspect-ratio: 1;
    --_g: no-repeat radial-gradient(farthest-side,rgb(var(--color-primary-500)) 90%,#0000);
    background: var(--_g), var(--_g), var(--_g), var(--_g);
    background-size: 40% 40%;
    animation: l46 1s infinite;
  }
  @keyframes l46 {
    0%  {background-position: 0 0      ,100% 0,100% 100%,0 100%}
    40%,
    50% {background-position: 100% 100%,100% 0,0    0   ,0 100%}
    90%,
    100%{background-position: 100% 100%,0 100%,0    0   ,100% 0}
  }

  .scrollbar-hide::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}
.scrollbar-hide {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;     /* Firefox */
}

.scroll-mask {
  --fade-left: 10%;
  --fade-right: 90%;
  --fade-left-c: transparent;
  --fade-right-c: transparent;

  -webkit-mask-image: linear-gradient(
    to right, 
    var(--fade-left-c) 0%, 
    black var(--fade-left), 
    black var(--fade-right), 
    var(--fade-right-c) 100%
  );
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;

  mask-image: linear-gradient(
    to right, 
    var(--fade-left-c) 0%, 
    black var(--fade-left), 
    black var(--fade-right), 
    var(--fade-right-c) 100%
  );
  mask-repeat: no-repeat;
  mask-size: 100% 100%;
  transition: --fade-left 0.3s ease, --fade-right 0.3s ease;
}

/* Left-side mask only */


