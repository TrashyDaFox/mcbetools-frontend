@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

:root {
  --color-septenary-50: 240 255 255;   /* #f0ffff */
  --color-septenary-100: 200 250 250;  /* #c8fafa */
  --color-septenary-200: 160 245 245;  /* #a0f5f5 */
  --color-septenary-300: 120 235 235;  /* #78ebeb */
  --color-septenary-400: 80 220 220;   /* #50dcdc */
  --color-septenary-500: 40 200 200;   /* #28c8c8 */
  --color-septenary-600: 35 175 175;   /* #23afaf */
  --color-septenary-700: 28 140 140;   /* #1c8c8c */
  --color-septenary-800: 20 100 100;   /* #146464 */
  --color-septenary-900: 15 70 70;     /* #0f4646 */
  --color-octonary-50: 240 255 240;   /* #f0fff0 */
--color-octonary-100: 210 250 210;  /* #d2fad2 */
--color-octonary-200: 180 245 180;  /* #b4f5b4 */
--color-octonary-300: 140 235 140;  /* #8ceb8c */
--color-octonary-400: 100 220 100;  /* #64dc64 */
--color-octonary-500: 60 200 60;    /* #3cc83c */
--color-octonary-600: 50 175 50;    /* #32af32 */
--color-octonary-700: 38 140 38;    /* #268c26 */
--color-octonary-800: 28 100 28;    /* #1c641c */
--color-octonary-900: 18 70 18;     /* #124612 */
--color-nonary-50: 240 245 255;   /* #f0f5ff */
--color-nonary-100: 210 225 255;  /* #d2e1ff */
--color-nonary-200: 180 200 255;  /* #b4c8ff */
--color-nonary-300: 140 170 245;  /* #8aAAF5 */
--color-nonary-400: 100 140 235;  /* #648ceb */
--color-nonary-500: 60 110 220;   /* #3c6edc */
--color-nonary-600: 50 95 190;    /* #325fbe */
--color-nonary-700: 38 70 150;    /* #264696 */
--color-nonary-800: 28 50 110;    /* #1c326e */
--color-nonary-900: 18 35 80;     /* #122350 */

  /* quaternary | #ff9bdc */
    --color-quaternary-50: 250 240 255; /* #faf0ff */
    --color-quaternary-100: 243 225 255; /* #f3e1ff */
    --color-quaternary-200: 234 200 255; /* #eac8ff */
    --color-quaternary-300: 214 160 246; /* #d6a0f6 */
    --color-quaternary-400: 194 120 236; /* #c278ec */
    --color-quaternary-500: 165 80 210;  /* #a550d2 */
    --color-quaternary-600: 142 65 182;  /* #8e41b6 */
    --color-quaternary-700: 115 52 145;  /* #733491 */
    --color-quaternary-800: 85 38 108;   /* #55266c */
    --color-quaternary-900: 60 27 76;    /* #3c1b4c */
    
  
    /* quinary | #ffe16c */
    --color-quinary-50: 255 250 230; /* #fffae6 */
    --color-quinary-100: 255 243 204; /* #fff3cc */
    --color-quinary-200: 255 230 153; /* #ffe699 */
    --color-quinary-300: 255 214 102; /* #ffd666 */
    --color-quinary-400: 255 196 51;  /* #ffc433 */
    --color-quinary-500: 255 178 0;   /* #ffb200 */
    --color-quinary-600: 224 156 0;   /* #e09c00 */
    --color-quinary-700: 181 126 0;   /* #b57e00 */
    --color-quinary-800: 138 96 0;    /* #8a6000 */
    --color-quinary-900: 96 66 0;     /* #604200 */
    
  
    /* senary | #f39ea7 */
    --color-senary-50: 255 240 242; /* #fff0f2 */
    --color-senary-100: 255 220 225; /* #ffdee1 */
    --color-senary-200: 255 190 198; /* #ffbec6 */
    --color-senary-300: 255 150 160; /* #ff96a0 */
    --color-senary-400: 245 100 120; /* #f56478 */
    --color-senary-500: 220 50 80;   /* #dc3250 */
    --color-senary-600: 190 40 70;   /* #be2846 */
    --color-senary-700: 150 30 55;   /* #961e37 */
    --color-senary-800: 110 20 40;   /* #6e1428 */
    --color-senary-900: 80 15 30;    /* #501e1e */
    
}
@layer utilities {
    /* === Quaternary === */
    .text-on-quaternary-token {
      color: rgb(var(--on-quaternary));
    }
    .text-quaternary-50-900-token {
      color: rgb(var(--color-quaternary-50));
    }
    .dark .text-quaternary-50-900-token {
      color: rgb(var(--color-quaternary-900));
    }
    .decoration-quaternary-50-900-token {
      text-decoration-color: rgb(var(--color-quaternary-50));
    }
    .dark .decoration-quaternary-50-900-token {
      text-decoration-color: rgb(var(--color-quaternary-900));
    }
  
    .text-quaternary-700-200-token {
      color: rgb(var(--color-quaternary-700));
    }
    .dark .text-quaternary-700-200-token {
      color: rgb(var(--color-quaternary-200));
    }
    .decoration-quaternary-700-200-token {
      text-decoration-color: rgb(var(--color-quaternary-700));
    }
    .dark .decoration-quaternary-700-200-token {
      text-decoration-color: rgb(var(--color-quaternary-200));
    }
  
    /* === Quinary === */
    .text-on-quinary-token {
      color: rgb(var(--on-quinary));
    }
    .text-quinary-50-900-token {
      color: rgb(var(--color-quinary-50));
    }
    .dark .text-quinary-50-900-token {
      color: rgb(var(--color-quinary-900));
    }
    .decoration-quinary-50-900-token {
      text-decoration-color: rgb(var(--color-quinary-50));
    }
    .dark .decoration-quinary-50-900-token {
      text-decoration-color: rgb(var(--color-quinary-900));
    }
  
    .text-quinary-700-200-token {
      color: rgb(var(--color-quinary-700));
    }
    .dark .text-quinary-700-200-token {
      color: rgb(var(--color-quinary-200));
    }
    .decoration-quinary-700-200-token {
      text-decoration-color: rgb(var(--color-quinary-700));
    }
    .dark .decoration-quinary-700-200-token {
      text-decoration-color: rgb(var(--color-quinary-200));
    }
  
    /* === Senary === */
    .text-on-senary-token {
      color: rgb(var(--on-senary));
    }
    .text-senary-50-900-token {
      color: rgb(var(--color-senary-50));
    }
    .dark .text-senary-50-900-token {
      color: rgb(var(--color-senary-900));
    }
    .decoration-senary-50-900-token {
      text-decoration-color: rgb(var(--color-senary-50));
    }
    .dark .decoration-senary-50-900-token {
      text-decoration-color: rgb(var(--color-senary-900));
    }
  
    .text-senary-700-200-token {
      color: rgb(var(--color-senary-700));
    }
    .dark .text-senary-700-200-token {
      color: rgb(var(--color-senary-200));
    }
    .decoration-senary-700-200-token {
      text-decoration-color: rgb(var(--color-senary-700));
    }
    .dark .decoration-senary-700-200-token {
      text-decoration-color: rgb(var(--color-senary-200));
    }
    /* === Quaternary === */
    .text-on-quaternary-token { color: rgb(var(--on-quaternary)); }

    .text-quaternary-50-900-token { color: rgb(var(--color-quaternary-50)); }
    .dark .text-quaternary-50-900-token { color: rgb(var(--color-quaternary-900)); }
  
    .text-quaternary-100-800-token { color: rgb(var(--color-quaternary-100)); }
    .dark .text-quaternary-100-800-token { color: rgb(var(--color-quaternary-800)); }
  
    .text-quaternary-200-700-token { color: rgb(var(--color-quaternary-200)); }
    .dark .text-quaternary-200-700-token { color: rgb(var(--color-quaternary-700)); }
  
    .text-quaternary-300-600-token { color: rgb(var(--color-quaternary-300)); }
    .dark .text-quaternary-300-600-token { color: rgb(var(--color-quaternary-600)); }
  
    .text-quaternary-400-500-token { color: rgb(var(--color-quaternary-400)); }
    .dark .text-quaternary-400-500-token { color: rgb(var(--color-quaternary-500)); }
  
    /* Decorations */
    .decoration-quaternary-50-900-token { text-decoration-color: rgb(var(--color-quaternary-50)); }
    .dark .decoration-quaternary-50-900-token { text-decoration-color: rgb(var(--color-quaternary-900)); }
  
    .decoration-quaternary-100-800-token { text-decoration-color: rgb(var(--color-quaternary-100)); }
    .dark .decoration-quaternary-100-800-token { text-decoration-color: rgb(var(--color-quaternary-800)); }
  
    .decoration-quaternary-200-700-token { text-decoration-color: rgb(var(--color-quaternary-200)); }
    .dark .decoration-quaternary-200-700-token { text-decoration-color: rgb(var(--color-quaternary-700)); }
  
    .decoration-quaternary-300-600-token { text-decoration-color: rgb(var(--color-quaternary-300)); }
    .dark .decoration-quaternary-300-600-token { text-decoration-color: rgb(var(--color-quaternary-600)); }
  
    .decoration-quaternary-400-500-token { text-decoration-color: rgb(var(--color-quaternary-400)); }
    .dark .decoration-quaternary-400-500-token { text-decoration-color: rgb(var(--color-quaternary-500)); }
  
    /* === Quinary === */
    .text-on-quinary-token { color: rgb(var(--on-quinary)); }
  
    .text-quinary-50-900-token { color: rgb(var(--color-quinary-50)); }
    .dark .text-quinary-50-900-token { color: rgb(var(--color-quinary-900)); }
  
    .text-quinary-100-800-token { color: rgb(var(--color-quinary-100)); }
    .dark .text-quinary-100-800-token { color: rgb(var(--color-quinary-800)); }
  
    .text-quinary-200-700-token { color: rgb(var(--color-quinary-200)); }
    .dark .text-quinary-200-700-token { color: rgb(var(--color-quinary-700)); }
  
    .text-quinary-300-600-token { color: rgb(var(--color-quinary-300)); }
    .dark .text-quinary-300-600-token { color: rgb(var(--color-quinary-600)); }
  
    .text-quinary-400-500-token { color: rgb(var(--color-quinary-400)); }
    .dark .text-quinary-400-500-token { color: rgb(var(--color-quinary-500)); }
  
    /* Decorations */
    .decoration-quinary-50-900-token { text-decoration-color: rgb(var(--color-quinary-50)); }
    .dark .decoration-quinary-50-900-token { text-decoration-color: rgb(var(--color-quinary-900)); }
  
    .decoration-quinary-100-800-token { text-decoration-color: rgb(var(--color-quinary-100)); }
    .dark .decoration-quinary-100-800-token { text-decoration-color: rgb(var(--color-quinary-800)); }
  
    .decoration-quinary-200-700-token { text-decoration-color: rgb(var(--color-quinary-200)); }
    .dark .decoration-quinary-200-700-token { text-decoration-color: rgb(var(--color-quinary-700)); }
  
    .decoration-quinary-300-600-token { text-decoration-color: rgb(var(--color-quinary-300)); }
    .dark .decoration-quinary-300-600-token { text-decoration-color: rgb(var(--color-quinary-600)); }
  
    .decoration-quinary-400-500-token { text-decoration-color: rgb(var(--color-quinary-400)); }
    .dark .decoration-quinary-400-500-token { text-decoration-color: rgb(var(--color-quinary-500)); }
  
    /* === Senary === */
    .text-on-senary-token { color: rgb(var(--on-senary)); }
    .text-on-septenary-token { color: rgb(var(--on-septenary)); }
  .text-on-octonary-token  { color: rgb(var(--on-octonary)); }
  .text-on-nonary-token    { color: rgb(var(--on-nonary)); }
    .text-senary-50-900-token { color: rgb(var(--color-senary-50)); }
    .dark .text-senary-50-900-token { color: rgb(var(--color-senary-900)); }
  
    .text-senary-100-800-token { color: rgb(var(--color-senary-100)); }
    .dark .text-senary-100-800-token { color: rgb(var(--color-senary-800)); }
  
    .text-senary-200-700-token { color: rgb(var(--color-senary-200)); }
    .dark .text-senary-200-700-token { color: rgb(var(--color-senary-700)); }
  
    .text-senary-300-600-token { color: rgb(var(--color-senary-300)); }
    .dark .text-senary-300-600-token { color: rgb(var(--color-senary-600)); }
  
    .text-senary-400-500-token { color: rgb(var(--color-senary-400)); }
    .dark .text-senary-400-500-token { color: rgb(var(--color-senary-500)); }
  
    /* Decorations */
    .decoration-senary-50-900-token { text-decoration-color: rgb(var(--color-senary-50)); }
    .dark .decoration-senary-50-900-token { text-decoration-color: rgb(var(--color-senary-900)); }
  
    .decoration-senary-100-800-token { text-decoration-color: rgb(var(--color-senary-100)); }
    .dark .decoration-senary-100-800-token { text-decoration-color: rgb(var(--color-senary-800)); }
  
    .decoration-senary-200-700-token { text-decoration-color: rgb(var(--color-senary-200)); }
    .dark .decoration-senary-200-700-token { text-decoration-color: rgb(var(--color-senary-700)); }
  
    .decoration-senary-300-600-token { text-decoration-color: rgb(var(--color-senary-300)); }
    .dark .decoration-senary-300-600-token { text-decoration-color: rgb(var(--color-senary-600)); }
  
    .decoration-senary-400-500-token { text-decoration-color: rgb(var(--color-senary-400)); }
    .dark .decoration-senary-400-500-token { text-decoration-color: rgb(var(--color-senary-500)); }
    .text-septenary-50-900-token { color: rgb(var(--color-septenary-50)); }
  .dark .text-septenary-50-900-token { color: rgb(var(--color-septenary-900)); }
  .decoration-septenary-50-900-token { text-decoration-color: rgb(var(--color-septenary-50)); }
  .dark .decoration-septenary-50-900-token { text-decoration-color: rgb(var(--color-septenary-900)); }

  .text-septenary-700-200-token { color: rgb(var(--color-septenary-700)); }
  .dark .text-septenary-700-200-token { color: rgb(var(--color-septenary-200)); }
  .decoration-septenary-700-200-token { text-decoration-color: rgb(var(--color-septenary-700)); }
  .dark .decoration-septenary-700-200-token { text-decoration-color: rgb(var(--color-septenary-200)); }

  /* Repeat for octonary */
  .text-octonary-50-900-token { color: rgb(var(--color-octonary-50)); }
  .dark .text-octonary-50-900-token { color: rgb(var(--color-octonary-900)); }
  .decoration-octonary-50-900-token { text-decoration-color: rgb(var(--color-octonary-50)); }
  .dark .decoration-octonary-50-900-token { text-decoration-color: rgb(var(--color-octonary-900)); }

  .text-octonary-700-200-token { color: rgb(var(--color-octonary-700)); }
  .dark .text-octonary-700-200-token { color: rgb(var(--color-octonary-200)); }
  .decoration-octonary-700-200-token { text-decoration-color: rgb(var(--color-octonary-700)); }
  .dark .decoration-octonary-700-200-token { text-decoration-color: rgb(var(--color-octonary-200)); }

  /* Repeat for nonary */
  .text-nonary-50-900-token { color: rgb(var(--color-nonary-50)); }
  .dark .text-nonary-50-900-token { color: rgb(var(--color-nonary-900)); }
  .decoration-nonary-50-900-token { text-decoration-color: rgb(var(--color-nonary-50)); }
  .dark .decoration-nonary-50-900-token { text-decoration-color: rgb(var(--color-nonary-900)); }

  .text-nonary-700-200-token { color: rgb(var(--color-nonary-700)); }
  .dark .text-nonary-700-200-token { color: rgb(var(--color-nonary-200)); }
  .decoration-nonary-700-200-token { text-decoration-color: rgb(var(--color-nonary-700)); }
  .dark .decoration-nonary-700-200-token { text-decoration-color: rgb(var(--color-nonary-200)); }

}
@layer components {
 
	/* Outline */
	.variant-outline-quaternary {
		@apply ring-[1px] ring-quaternary-500 dark:ring-quaternary-500 ring-inset;
	}
	.variant-outline-quinary {
		@apply ring-[1px] ring-quinary-500 dark:ring-quinary-500 ring-inset;
	}
	.variant-outline-senary {
		@apply ring-[1px] ring-senary-500 dark:ring-senary-500 ring-inset;
	}

	/* Filled */
	.variant-filled-quaternary {
		@apply bg-quaternary-500 dark:bg-quaternary-500 text-on-quaternary-token dark:text-on-quaternary-token;
	}
	.variant-filled-quinary {
		@apply bg-quinary-500 dark:bg-quinary-500 text-on-quinary-token dark:text-on-quinary-token;
	}
	.variant-filled-senary {
		@apply bg-senary-500 dark:bg-senary-500 text-on-senary-token dark:text-on-senary-token;
	}

	/* Ringed */
	.variant-ringed-quaternary {
		@apply bg-transparent dark:bg-transparent variant-outline-quaternary;
	}
	.variant-ringed-quinary {
		@apply bg-transparent dark:bg-transparent variant-outline-quinary;
	}
	.variant-ringed-senary {
		@apply bg-transparent dark:bg-transparent variant-outline-senary;
	}

	/* Ghost */
	.variant-ghost-quaternary {
		@apply bg-quaternary-500/20 dark:bg-quaternary-500/20 variant-outline-quaternary;
	}
	.variant-ghost-quinary {
		@apply bg-quinary-500/20 dark:bg-quinary-500/20 variant-outline-quinary;
	}
	.variant-ghost-senary {
		@apply bg-senary-500/20 dark:bg-senary-500/20 variant-outline-senary;
	}

	/* Soft */
	.variant-soft-quaternary {
		@apply bg-quaternary-400/20 dark:bg-quaternary-500/20 text-quaternary-700-200-token !ring-0;
	}
	.variant-soft-quinary {
		@apply bg-quinary-400/20 dark:bg-quinary-500/20 text-quinary-700-200-token !ring-0;
	}
	.variant-soft-senary {
		@apply bg-senary-400/20 dark:bg-senary-500/20 text-senary-700-200-token !ring-0;
	}

	/* Glass */
	.variant-glass-quaternary {
		@apply bg-quaternary-500/20 dark:bg-quaternary-500/20 backdrop-blur-lg;
	}
	.variant-glass-quinary {
		@apply bg-quinary-500/20 dark:bg-quinary-500/20 backdrop-blur-lg;
	}
	.variant-glass-senary {
		@apply bg-senary-500/20 dark:bg-senary-500/20 backdrop-blur-lg;
	}

	/* Gradients (extra combos with new trio) */
	.variant-gradient-quaternary-quinary {
		@apply from-quaternary-500 to-quinary-500 text-on-quaternary-token;
	}
	.variant-gradient-quinary-senary {
		@apply from-quinary-500 to-senary-500 text-on-quinary-token;
	}
	.variant-gradient-senary-quaternary {
		@apply from-senary-500 to-quaternary-500 text-on-senary-token;
	}

	/* reversed */
	.variant-gradient-quinary-quaternary {
		@apply from-quinary-500 to-quaternary-500 text-on-quinary-token;
	}
	.variant-gradient-senary-quinary {
		@apply from-senary-500 to-quinary-500 text-on-senary-token;
	}
	.variant-gradient-quaternary-senary {
		@apply from-quaternary-500 to-senary-500 text-on-quaternary-token;
	}

    /* Outline */
    .variant-outline-septenary { @apply ring-[1px] ring-septenary-500 ring-inset; }
    .variant-outline-octonary  { @apply ring-[1px] ring-octonary-500 ring-inset; }
    .variant-outline-nonary    { @apply ring-[1px] ring-nonary-500 ring-inset; }
  
    /* Filled */
    .variant-filled-septenary { @apply bg-septenary-500 text-on-septenary-token; }
    .variant-filled-octonary  { @apply bg-octonary-500 text-on-octonary-token; }
    .variant-filled-nonary    { @apply bg-nonary-500 text-on-nonary-token; }
  
    /* Soft */
    .variant-soft-septenary { @apply bg-septenary-400/20 text-septenary-700-200-token !ring-0; }
    .variant-soft-octonary  { @apply bg-octonary-400/20 text-octonary-700-200-token !ring-0; }
    .variant-soft-nonary    { @apply bg-nonary-400/20 text-nonary-700-200-token !ring-0; }
  
    /* Ghost */
    .variant-ghost-septenary { @apply bg-septenary-500/20 variant-outline-septenary; }
    .variant-ghost-octonary  { @apply bg-octonary-500/20 variant-outline-octonary; }
    .variant-ghost-nonary    { @apply bg-nonary-500/20 variant-outline-nonary; }
  
    /* Glass */
    .variant-glass-septenary { @apply bg-septenary-500/20 backdrop-blur-lg; }
    .variant-glass-octonary  { @apply bg-octonary-500/20 backdrop-blur-lg; }
    .variant-glass-nonary    { @apply bg-nonary-500/20 backdrop-blur-lg; }
  
    /* Gradients */
    .variant-gradient-septenary-octonary { @apply from-septenary-500 to-octonary-500 text-on-septenary-token; }
    .variant-gradient-septenary-nonary   { @apply from-septenary-500 to-nonary-500 text-on-septenary-token; }
    .variant-gradient-octonary-nonary    { @apply from-octonary-500 to-nonary-500 text-on-octonary-token; }
  
}
html .fancy-title2 {
  font-weight: 800;
  position: relative;
  color: black;
}
html .fancy-title3 {
  color: white !important;
}
html.dark .fancy-title3 {
  color: transparent;
}
