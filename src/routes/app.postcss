  font-weight: 800;
  background: linear-gradient(
    -45deg,
    #ff80ff,
    #ff9aff,
    #80fff7,
    #9adeff,
    #ff80ff
  );
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 4s ease-in-out infinite;
